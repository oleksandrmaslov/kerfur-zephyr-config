#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
#if defined(CONFIG_USB_DEVICE_STACK) && CONFIG_USB_DEVICE_STACK
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
#else
		zephyr,console = &pro_micro_serial;
		zephyr,shell-uart = &pro_micro_serial;
#endif
	};

	aliases {
		touch0 = &pet_touch0;
	};

	/*
	 * Digital touch sensor input (default pin P0.31 / D21).
	 * TODO: Change this pin/flags to match your touch module output.
	 */
	touch_inputs {
		compatible = "gpio-keys";

		pet_touch0: pet_touch_0 {
			label = "PET_TOUCH_0";
			gpios = <&gpio0 31 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};
};

#if defined(CONFIG_USB_DEVICE_STACK) && CONFIG_USB_DEVICE_STACK
&usbd {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
#endif

/*
 * nice!nano note:
 * P0.13 controls external VCC switch; HIGH can cut VCC rail.
 * Hold it LOW by default so external peripherals (OLED, sensors) stay powered.
 */
&gpio0 {
	ext_power_default_on {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "ext_vcc_on";
	};
};
