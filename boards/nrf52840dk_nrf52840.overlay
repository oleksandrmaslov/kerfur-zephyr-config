/ {
	chosen {
		/* TODO: Change chosen display node if your board uses another panel. */
		zephyr,display = &ssd1306;
	};
};

&arduino_i2c {
	status = "okay";

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
		status = "okay";
	};
};
