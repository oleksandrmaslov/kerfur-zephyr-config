source "Kconfig.zephyr"

menu "Kerfur Firmware"

config KERFUR_ENABLE_BLE
	bool "Enable Kerfur BLE connectivity stack"
	default y
	help
	  Enables connectable advertising, Kerfur GATT services and BLE event
	  plumbing used by iOS ANCS and Android companion integrations.

config KERFUR_ENABLE_ANCS
	bool "Enable iOS ANCS notification intake over BLE"
	default y
	depends on KERFUR_ENABLE_BLE
	help
	  Discovers and subscribes to Apple's ANCS Notification Source on
	  paired iOS devices. Incoming ANCS "notification added" events are
	  mapped to APP_EVENT_PHONE_NOTIFICATION.

config KERFUR_ENABLE_ANS_FALLBACK
	bool "Enable Alert Notification Service fallback client"
	default y
	depends on KERFUR_ENABLE_BLE
	help
	  Enables discovery of standard Alert Notification Service (UUID 0x1811)
	  on connected phones when ANCS is not available. This is best-effort:
	  many Android phones do not expose ANS at OS level.

config KERFUR_ENABLE_KEYRING_PROFILE
	bool "Enable keyring Find Me / Proximity profile"
	default n
	depends on KERFUR_ENABLE_BLE
	select BT_IAS
	select BT_TPS
	help
	  Enables standard BLE services typically used by key finder accessories:
	  Immediate Alert Service (0x1802), Link Loss Service (0x1803), and
	  TX Power Service (0x1804). This improves interoperability with generic
	  BLE tooling and keeps the device aligned with keyring appearance.

config KERFUR_ENABLE_COMPANION
	bool "Enable custom companion BLE channel (optional)"
	default n
	depends on KERFUR_ENABLE_BLE
	help
	  Enables custom Kerfur companion RX/TX characteristics for use with an
	  Android companion app. Keep disabled to minimize BLE footprint.

config KERFUR_ENABLE_RSC_SERVICE
	bool "Enable Running Speed and Cadence service scaffold"
	default n
	depends on KERFUR_ENABLE_BLE
	help
	  Exposes standard RSCS (UUID 0x1814) as future foundation for
	  pedometer/step cadence telemetry without custom BLE service.

config KERFUR_ENABLE_NEARBY
	bool "Enable Kerfur-to-Kerfur nearby detection"
	default y
	depends on KERFUR_ENABLE_BLE
	select BT_OBSERVER
	help
	  Enables an anonymous Kerfur nearby beacon (in scan response
	  manufacturer data) and a duty-cycled active scanner that tracks
	  other Kerfur devices, runs a small encounter state machine, and
	  feeds peer events into the behavior engine.

if KERFUR_ENABLE_NEARBY

config KERFUR_NEARBY_PEER_TABLE_SIZE
	int "Max tracked nearby peers"
	range 2 16
	default 8

config KERFUR_NEARBY_ENCOUNTER_LOG_SIZE
	int "Encounter log ring buffer size"
	range 4 64
	default 16

config KERFUR_NEARBY_RSSI_NEAR_DBM
	int "RSSI threshold to enter NEAR (dBm)"
	range -100 -30
	default -75

config KERFUR_NEARBY_RSSI_LOST_DBM
	int "RSSI hysteresis to leave NEAR (dBm)"
	range -100 -30
	default -90

config KERFUR_NEARBY_INTERACT_HOLD_MS
	int "Time stable in NEAR before INTERACTING (ms)"
	range 500 30000
	default 3000

config KERFUR_NEARBY_COOLDOWN_MS
	int "Cooldown after encounter ends (ms)"
	range 5000 600000
	default 60000

config KERFUR_NEARBY_ID_ROTATE_S
	int "Ephemeral id rotation period (s)"
	range 60 86400
	default 900

config KERFUR_NEARBY_MAX_FRIENDS
	int "Maximum confirmed-friend slots (persisted in NVS)"
	range 0 128
	default 64
	help
	  Number of confirmed-friend relationships that survive reboots and
	  ephemeral ID rotation.  Friends are stored in settings/NVS and
	  recognized by IRK-style cryptographic ID resolution — requires
	  wall-clock sync via the companion app.  Set to 0 to disable
	  persistent friend recognition entirely.
	  64 is enough for years of carrying Kerfur to meetups and events.
	  RAM cost: ~64 bytes per slot.  CPU cost: 3 CRC32 calls per friend
	  per received beacon (~2 µs each on nRF52840).

endif

config KERFUR_ENABLE_SHELL_CMDS
	bool "Enable Kerfur USB shell BLE maintenance commands"
	default y
	depends on KERFUR_ENABLE_BLE && SHELL
	help
	  Enables `kerfur ble ...` shell commands on USB serial backend.

config KERFUR_ENABLE_FACE_SHELL_CMDS
	bool "Enable Kerfur face debug shell commands"
	default n
	depends on KERFUR_ENABLE_SHELL_CMDS && KERFUR_FACE_DEBUG
	help
	  Enables `kerfur face ...` shell commands for debug-only expression,
	  reaction, gaze, carry-state and battery injection. Keep disabled in
	  normal builds so the face debug shell surface is compiled out.

config KERFUR_ENABLE_MOCK_INPUTS
	bool "Enable periodic mock external events"
	default y
	help
	  Keeps the pet behavior active before all real sensors are added.

config KERFUR_MOTION
	bool "Enable Kerfur motion sensing and classification"
	default y
	select SENSOR
	imply LSM6DSO
	imply LSM6DSO_TILT
	help
	  Enables the IMU abstraction, motion classifier, pickup and in-hand
	  detection, and tilt-driven gaze integration. If no `motion0` DT alias
	  exists, the firmware still builds and the motion stack remains disabled
	  at runtime.

if KERFUR_MOTION

config KERFUR_MOTION_IDLE_ODR_HZ
	int "Idle accelerometer sampling rate (Hz)"
	range 1 26
	default 12
	help
	  Target low-power accelerometer rate while waiting for motion wake.

config KERFUR_MOTION_ACTIVE_ODR_HZ
	int "Active accelerometer sampling rate (Hz)"
	range 12 104
	default 26
	help
	  Target accelerometer rate used during active classification windows.

config KERFUR_MOTION_ACTIVE_WINDOW_MS
	int "Active classification window (ms)"
	range 500 10000
	default 3000
	help
	  Duration of the motion analysis burst after a wake trigger.

config KERFUR_MOTION_STEP_BATCH_SIZE
	int "Step batch publish size"
	range 1 32
	default 8
	help
	  Number of accumulated steps before publishing APP_EVENT_STEP_BATCH.

config KERFUR_MOTION_WALK_START_THRESHOLD
	int "Walking start confidence threshold"
	range 1 100
	default 70
	help
	  Walking begins when confidence reaches this threshold.

config KERFUR_MOTION_WALK_STOP_THRESHOLD
	int "Walking stop confidence threshold"
	range 1 100
	default 45
	help
	  Walking ends when confidence falls below this threshold.

config KERFUR_MOTION_GAZE_RATE_HZ
	int "Maximum tilt gaze update rate (Hz)"
	range 1 20
	default 10
	help
	  Maximum rate for LOOK_TARGET updates while tracking in-hand tilt.

config KERFUR_MOTION_GAZE_TILT_DIVISOR_MG
	int "Tilt amount needed for full-scale gaze target (mg)"
	range 80 600
	default 170
	help
	  Lower values make pupils react more strongly to tilt. This is applied
	  after board axis remapping and relative in-hand neutral capture.

config KERFUR_MOTION_AXIS_SWAP_XY
	bool "Swap motion sensor X and Y axes"
	default n
	help
	  Use when the IMU is mounted rotated 90 degrees relative to the display.

config KERFUR_MOTION_AXIS_INVERT_X
	bool "Invert motion sensor X axis"
	default n
	help
	  Use when left-right tilt is mirrored relative to the display.

config KERFUR_MOTION_AXIS_INVERT_Y
	bool "Invert motion sensor Y axis"
	default n
	help
	  Use when up-down tilt is mirrored relative to the display.

config KERFUR_MOTION_AXIS_INVERT_Z
	bool "Invert motion sensor Z axis"
	default n
	help
	  Use when the IMU is mounted on the opposite side of the display plane.

endif

config KERFUR_BATTERY
	bool "Enable battery / charger monitor"
	default y
	help
	  Enables the battery_monitor module, which owns a battery_backend,
	  polls it, and publishes BATTERY_PERCENT_UPDATE / CHARGER_CONNECTED /
	  CHARGER_DISCONNECTED app events. With the default stub backend it
	  reports everything as unknown (no behavior change); select a real
	  backend below once charger hardware is wired.

if KERFUR_BATTERY

config KERFUR_BATTERY_POLL_MS
	int "Battery monitor poll period (ms)"
	range 250 60000
	default 2000
	help
	  How often battery_monitor reads the backend. Kept slow to stay
	  low-power; charger/gauge interrupt lines can drive faster updates
	  later once their GPIOs are mapped.

config KERFUR_CHARGER_BQ2563X
	bool "Use BQ25630 charger + MAX17048 fuel gauge backend (I2C)"
	default n
	select I2C
	help
	  Selects the real power backend: a TI BQ25630 charger (charger0 alias,
	  0x6B) for charger-present / charge-state / OTG, and a MAX17048 fuel
	  gauge (fuel_gauge0 alias, 0x36) for state-of-charge and cell voltage.
	  Safe to enable before the board overlay defines those aliases: the
	  backend then degrades to "unknown" at runtime. Leave disabled to use
	  the stub backend.

endif

config KERFUR_TOUCH_IQS7222A
	bool "Use Azoteq IQS7222A capacitive touch controller"
	default n
	select I2C
	select GPIO
	help
	  Replaces the single-GPIO touch front-end with the IQS7222A capacitive
	  controller (I2C + RDY line, `touch_iqs0` alias). Reads per-channel
	  touch state and feeds the shared gesture engine. Safe to enable before
	  the board overlay exists: the driver returns -ENODEV at runtime and the
	  GPIO front-end stays available. Needs a tuned config export for correct
	  sensitivity (see kerfur_iqs7222a_config.c).

if KERFUR_TOUCH_IQS7222A

config KERFUR_TOUCH_IQS7222A_CHANNELS
	int "IQS7222A petting channels"
	range 1 10
	default 6
	help
	  Number of capacitive channels used as petting zones. Touch bits above
	  this (e.g. the Hall channel) are ignored by the gesture engine.

endif

config KERFUR_WORN_EXPRESSIVE
	bool "Stay expressive while worn on jeans/backpack"
	default n
	help
	  Default worn style. When disabled (quiet companion, recommended),
	  a Kerfur detected as WORN lets its screen rest, suppresses motion/
	  notification display wake-ups and idle fidgeting, keeps counting
	  steps and stays socially awake (other Kerfurs still light it up).
	  When enabled, the face stays ambient and reactive while dangling.
	  The owner's runtime choice (`kerfur emotion worn ...`, future app)
	  is persisted in emotional memory and overrides this default.

config KERFUR_EMOTION_MEMORY
	bool "Persist slow emotional traits across reboots"
	default y
	depends on SETTINGS
	help
	  Stores the slow relationship traits (attachment, trust, mood,
	  lifetime petting count, personality) in one small settings/NVS
	  record so Kerfur remembers its owner across power cycles. Fast
	  drives (arousal, stress, boredom, ...) always boot fresh. Saves
	  are throttled by the behavior engine (about one write per 30 min
	  of active drift) to protect flash.

config KERFUR_IDLE_TIMEOUT_S
	int "Idle timeout (seconds)"
	range 5 3600
	default 45
	help
	  Time without real user interaction before APP_EVENT_IDLE_TIMEOUT.

config KERFUR_DISPLAY_BLANK_TIMEOUT_S
	int "Display blank timeout (seconds)"
	range 10 7200
	default 90
	help
	  Time without real user interaction before display blanking.

config KERFUR_SLEEP_REQUEST_TIMEOUT_S
	int "Sleep request timeout (seconds)"
	range 20 14400
	default 180
	help
	  Time without real user interaction before APP_EVENT_SLEEP_REQUEST.

config KERFUR_UI_FRAME_MS
	int "UI frame period (milliseconds)"
	range 50 1000
	default 120
	help
	  Controls renderer update cadence. Lower is smoother and costs power.

config KERFUR_TRACE_EVENTS
	bool "Verbose app event/state tracing"
	default y
	help
	  Adds extra runtime logs in app/core/behavior/power paths for
	  easier bring-up and troubleshooting.

config KERFUR_FACE_DEBUG
	bool "Enable modular face debug hooks"
	default y
	help
	  Enables face-state debug events and shell-triggered dump plumbing for
	  the modular face rewrite.

config KERFUR_FACE_DEBUG_VERBOSE
	bool "Enable verbose modular face debug logging"
	default n
	depends on KERFUR_FACE_DEBUG
	help
	  Adds detailed face snapshot logs for look/carry/battery updates and
	  debug-dump requests.

endmenu
