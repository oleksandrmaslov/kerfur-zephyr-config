  "micro_animations": [
    {
      "id": "pupil_idle_drift",
      "type": "pupil_motion",
      "duration_ms": 1600,
      "loop": true,
      "params": {
        "radius_x": 1,
        "radius_y": 1,
        "speed": "slow"
      }
    },
    {
      "id": "glance_left",
      "type": "look_target",
      "duration_ms": 900,
      "loop": false,
      "params": {
        "target_x": -100,
        "target_y": 0,
        "return_to_base": true
      }
    },
    {
      "id": "glance_right",
      "type": "look_target",
      "duration_ms": 900,
      "loop": false,
      "params": {
        "target_x": 100,
        "target_y": 0,
        "return_to_base": true
      }
    },
    {
      "id": "look_up",
      "type": "look_target",
      "duration_ms": 700,
      "loop": false,
      "params": {
        "target_x": 0,
        "target_y": -100,
        "return_to_base": true
      }
    },
    {
      "id": "look_down",
      "type": "look_target",
      "duration_ms": 700,
      "loop": false,
      "params": {
        "target_x": 0,
        "target_y": 100,
        "return_to_base": true
      }
    },
    {
      "id": "tear_well_up",
      "type": "effect_spawn",
      "duration_ms": 1200,
      "loop": false,
      "params": {
        "effect_id": "effect_tear",
        "offset_x": -2,
        "offset_y": 2
      }
    }
  ],

